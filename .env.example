# Optional local overrides for the Docker/runtime configuration.

# Backend runtime SPARQL endpoint. In docker-compose this resolves to the Fuseki service.
TWIN_SPARQL_ENDPOINT_URL=http://localhost:3030/twin/sparql

# Graph Store endpoint used by the refresh publisher.
TWIN_GRAPH_STORE_URL=http://localhost:3030/twin/data?default

# Local Turtle export directory used as fallback/debug state.
TWIN_DATA_DIR=data

# Frontend API base for non-Compose development.
VITE_API_BASE_URL=http://localhost:8000
