@prefix city: <https://example.org/berlin/ontology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

city:AirQualityStation a rdfs:Class ;
    rdfs:label "Air quality station" .

city:AirQualityIndexObservation a rdfs:Class ;
    rdfs:label "Air quality index observation" .

city:WeatherObservation a rdfs:Class ;
    rdfs:label "Weather observation" .

city:TransitObservation a rdfs:Class ;
    rdfs:label "Transit observation" .

city:UrbanStressObservation a rdfs:Class ;
    rdfs:label "Urban stress observation" .

city:stationCode a rdf:Property ; rdfs:label "station code" .
city:name a rdf:Property ; rdfs:label "name" .
city:address a rdf:Property ; rdfs:label "address" .
city:isActive a rdf:Property ; rdfs:label "is active" ; rdfs:range xsd:boolean .
city:stationCategory a rdf:Property ; rdfs:label "station category" .
city:observedAt a rdf:Property ; rdfs:label "observed at" ; rdfs:range xsd:dateTime .
city:airQualityGrade a rdf:Property ; rdfs:label "Berlin air quality index grade" ; rdfs:range xsd:integer .
city:observedAtStation a rdf:Property ; rdfs:label "observed at station" .
city:lqiPM10 a rdf:Property ; rdfs:label "LQI grade for PM10" ; rdfs:range xsd:integer .
city:lqiPM25 a rdf:Property ; rdfs:label "LQI grade for PM2.5" ; rdfs:range xsd:integer .
city:lqiNO2 a rdf:Property ; rdfs:label "LQI grade for NO2" ; rdfs:range xsd:integer .
city:lqiO3 a rdf:Property ; rdfs:label "LQI grade for O3" ; rdfs:range xsd:integer .
city:lqiCO a rdf:Property ; rdfs:label "LQI grade for CO" ; rdfs:range xsd:integer .
city:lqiSO2 a rdf:Property ; rdfs:label "LQI grade for SO2" ; rdfs:range xsd:integer .
city:temperatureCelsius a rdf:Property ; rdfs:label "temperature in degrees Celsius" ; rdfs:range xsd:double .
city:relativeHumidityPercent a rdf:Property ; rdfs:label "relative humidity percent" ; rdfs:range xsd:double .
city:pressureHpa a rdf:Property ; rdfs:label "mean sea level pressure in hPa" ; rdfs:range xsd:double .
city:windSpeedKmh a rdf:Property ; rdfs:label "wind speed in kilometres per hour" ; rdfs:range xsd:double .
city:weatherCondition a rdf:Property ; rdfs:label "weather condition" .
city:totalTripUpdates a rdf:Property ; rdfs:label "total trip updates" ; rdfs:range xsd:integer .
city:delayedTripUpdates a rdf:Property ; rdfs:label "delayed trip updates" ; rdfs:range xsd:integer .
city:maxDelaySeconds a rdf:Property ; rdfs:label "maximum delay in seconds" ; rdfs:range xsd:integer .
city:delayedShare a rdf:Property ; rdfs:label "share of delayed trip updates" ; rdfs:range xsd:double .
city:urbanStressIndex a rdf:Property ; rdfs:label "urban stress index" ; rdfs:range xsd:double .
city:airQualityStressComponent a rdf:Property ; rdfs:label "air quality stress component" ; rdfs:range xsd:double .
city:heatStressComponent a rdf:Property ; rdfs:label "heat stress component" ; rdfs:range xsd:double .
city:transitStressComponent a rdf:Property ; rdfs:label "transit stress component" ; rdfs:range xsd:double .
