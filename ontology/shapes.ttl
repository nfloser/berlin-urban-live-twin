@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix city: <https://example.org/berlin/ontology/> .
@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

city:AirQualityStationShape a sh:NodeShape ;
    sh:targetClass city:AirQualityStation ;
    sh:property [ sh:path city:stationCode ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path city:name ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path city:isActive ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
    sh:property [ sh:path geo:lat ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ; sh:minInclusive -90 ; sh:maxInclusive 90 ] ;
    sh:property [ sh:path geo:long ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ; sh:minInclusive -180 ; sh:maxInclusive 180 ] .

city:AirQualityIndexObservationShape a sh:NodeShape ;
    sh:targetClass city:AirQualityIndexObservation ;
    sh:property [ sh:path city:observedAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path city:observedAtStation ; sh:minCount 1 ; sh:maxCount 1 ; sh:class city:AirQualityStation ] ;
    sh:property [ sh:path city:airQualityGrade ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 6 ] ;
    sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:nodeKind sh:IRI ] .

city:WeatherObservationShape a sh:NodeShape ;
    sh:targetClass city:WeatherObservation ;
    sh:property [ sh:path city:observedAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path city:temperatureCelsius ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ; sh:minInclusive -60 ; sh:maxInclusive 60 ] ;
    sh:property [ sh:path city:relativeHumidityPercent ; sh:maxCount 1 ; sh:datatype xsd:double ; sh:minInclusive 0 ; sh:maxInclusive 100 ] ;
    sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:nodeKind sh:IRI ] .

city:TransitObservationShape a sh:NodeShape ;
    sh:targetClass city:TransitObservation ;
    sh:property [ sh:path city:observedAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path city:totalTripUpdates ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
    sh:property [ sh:path city:delayedTripUpdates ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
    sh:property [ sh:path city:maxDelaySeconds ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
    sh:property [ sh:path city:delayedShare ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ; sh:minInclusive 0 ; sh:maxInclusive 1 ] ;
    sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:nodeKind sh:IRI ] .

city:UrbanStressObservationShape a sh:NodeShape ;
    sh:targetClass city:UrbanStressObservation ;
    sh:property [ sh:path city:observedAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path city:urbanStressIndex ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ; sh:minInclusive 0 ; sh:maxInclusive 100 ] ;
    sh:property [ sh:path city:airQualityStressComponent ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ; sh:minInclusive 0 ; sh:maxInclusive 1 ] ;
    sh:property [ sh:path city:heatStressComponent ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ; sh:minInclusive 0 ; sh:maxInclusive 1 ] ;
    sh:property [ sh:path city:transitStressComponent ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ; sh:minInclusive 0 ; sh:maxInclusive 1 ] ;
    sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 3 ; sh:nodeKind sh:IRI ] .
